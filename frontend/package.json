{
  "name": "frpc-web-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.ts *.json index.html",
    "format:check": "prettier --check src e2e *.ts *.json index.html"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "naive-ui": "^2.43.2",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vue-tsc": "^3.1.1"
  }
}
